# ============ local only: never commit ============
# agent workspace data (memory / daily logs)
.workbuddy/
# SSH authorized-key usage notes, local security info, see the file itself
SSH-USAGE.md
# personal reference screenshots (content folded into docs/03-reference.md §13)
Screenshot_*.jpg
# docs/ — entire folder not tracked (plan is SnipDeck-PLAN.md at repo root).
# untracked via `git rm --cached -r docs/` (history preserved).
docs/

# ============ runtime data and secrets ============
# keys / tokens, gitignored by default (PLAN 5.4)
data/secrets.yaml
# local env (SNIP_TOKEN etc.), copy .env.example to .env
.env
# 桥的两条目录配置（PROG_DIR / AHK_DIR）——每台机器不一样，网页上改的就是它
data/settings.json
# 程序发现的范围（only / extraRoots / include）——每台机器装的软件不一样
data/programs.yaml
# 便携 exe 的 .lnk 包装（服务端按需生成，可随时删；删了下次扫描会重建）
data/program-links/
# server logs (scripts/start-server.ps1)
data/logs/
# temp batch files run-<runId>.cmd
data/tmp/
# run history jsonl
data/runs/
# 删除片段时的副本（CRUD 的回收站，扩展名是 .yaml.txt，不会被当成片段加载）
data/snippets/.trash/
# 回归脚本自建的临时片段（npm run ui:editor）。脚本正常结束会删掉，
# 中途失败就会留下，别让它混进仓库当真人片段
data/snippets/**/zz-ui-editor-*.yaml

# ============ dependencies and build ============
node_modules/
dist/
*.tsbuildinfo

# ============ backups and logs ============
*.bak
*.log

# ============ editor / OS ============
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
