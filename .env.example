# 复制为 .env 后按需修改（.env 已被 gitignore，不会进仓库）

# 监听地址
#   127.0.0.1       只本机（默认，安全）
#   100.x.x.x       走 Tailscale，手机可访问 —— 此时必须设置 SNIP_TOKEN，否则服务拒绝启动
SNIPDECK_HOST=127.0.0.1
SNIPDECK_PORT=7878

# 远端准入 token（对外监听时必填）。生成：
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# SNIP_TOKEN=

# 数据目录与前端产物，一般不用改
# SNIPDECK_DATA=data
# SNIPDECK_WEB_DIST=packages/web/dist
