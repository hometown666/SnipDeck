{
  "name": "snipdeck",
  "version": "1.7.0",
  "private": true,
  "description": "SnipDeck - self-hosted snippet deck with AHK bridge (exec driver)",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "snip": "npm run snip --workspace @snipdeck/cli --",
    "dev:server": "npm run dev --workspace @snipdeck/server",
    "dev:web": "npm run dev --workspace @snipdeck/web",
    "build:web": "npm run build --workspace @snipdeck/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-ps1.ps1",
    "test:queue": "npm run test:queue --workspace @snipdeck/drivers",
    "test:cmd": "npm run test:cmd --workspace @snipdeck/drivers",
    "test": "npm run typecheck && npm run lint && npm run check:ps1 && npm run test:queue && npm run test:cmd && npm run test:search && npm run test:expect && npm run test:import && npm run test:session && npm run smoke --workspace @snipdeck/server",
    "sync:launchers": "node scripts/sync-launchers.mjs",
    "clean:tmp": "node scripts/clean-tmp.mjs",
    "ui:shot": "node scripts/ui-shot.mjs",
    "test:search": "npm run test:search --workspace @snipdeck/core",
    "ui:queue": "node scripts/check-queue-badge.mjs",
    "ui:multi": "node scripts/check-multi-target.mjs",
    "test:expect": "npm run test:expect --workspace @snipdeck/core",
    "test:import": "npm run test:import --workspace @snipdeck/core",
    "ui:history": "node scripts/check-history.mjs",
    "test:session": "npm run test:session --workspace @snipdeck/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  }
}
