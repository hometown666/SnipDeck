{
  "name": "snipdeck",
  "version": "0.1.0",
  "private": true,
  "description": "SnipDeck - self-hosted snippet deck with AHK bridge (exec driver)",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "snip": "npm run snip --workspace @snipdeck/cli --",
    "dev:server": "npm run dev --workspace @snipdeck/server",
    "dev:web": "npm run dev --workspace @snipdeck/web",
    "build:web": "npm run build --workspace @snipdeck/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:queue": "npm run test:queue --workspace @snipdeck/drivers",
    "test:cmd": "npm run test:cmd --workspace @snipdeck/drivers",
    "test": "npm run typecheck && npm run test:queue && npm run test:cmd && npm run test:search && npm run smoke --workspace @snipdeck/server",
    "sync:launchers": "node scripts/sync-launchers.mjs",
    "ui:shot": "node scripts/ui-shot.mjs",
    "test:search": "npm run test:search --workspace @snipdeck/core",
    "ui:queue": "node scripts/check-queue-badge.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
